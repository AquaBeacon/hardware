	(text "キャリア基板側に置く (充電ポンプノードなので XH で引き回さない)"
		(exclude_from_sim no)
		(at 18 262 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a5f8fdee-3960-49b9-82f4-5352f2eabd4f")
	)
	(text "BTN_ADC: UP=0V / ENT=0.82V / DN=1.65V / 無押下=3.3V"
		(exclude_from_sim no)
		(at 18 266 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b20d249e-e67a-4034-a1e4-21c6f8c217bd")
	)
	(text "[1] 基板間"
		(exclude_from_sim no)
		(at 284 145 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "20182fea-4582-4088-90e2-2422beae14cf")
	)
	(text "  J_PWR1 = C-PWR J_MAIN と同一ピン順 (ストレート9芯1本)"
		(exclude_from_sim no)
		(at 284 150 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8bbde334-9a26-4ba6-96a8-923e2790b1d4")
	)
	(text "  I2C対(5/6) を GND(4/7) で挟み、LIGHT_PWM(9) を電源ピンから離してある"
		(exclude_from_sim no)
		(at 284 154 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4ac15de0-c190-41f9-9fa2-c99198a13227")
	)
	(text "  J_RX1 = 製造済み RX_improved_mini の J2 と同一ピン順 (pin5 は RX 側 NC)"
		(exclude_from_sim no)
		(at 284 158 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1efc8de6-d6f2-4a34-a101-61df23b371b7")
	)
	(text "[2] プルアップ / DNP"
		(exclude_from_sim no)
		(at 284 165 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "6b36c573-1ca9-4708-ab4d-48e08819bba1")
	)
	(text "  R_SDA/R_SCL (4.7k) は既定 DNP。組立後に SDA/SCL-V3D 間を実測して要否を決める"
		(exclude_from_sim no)
		(at 284 170 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bcb3941f-b2ca-44d5-a609-b647a73cd754")
	)
	(text "  バスは 2 基板 + 4 ケーブルに跨るので、総容量が大きければ 2.2k も検討 (tr<1us)"
		(exclude_from_sim no)
		(at 284 174 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ae27cf2d-121f-4d6f-9406-365d410b3b50")
	)
	(text "  R_SDCS: 起動時 Pico GPIO は Hi-Z -> CS フロート防止 (v4.3)"
		(exclude_from_sim no)
		(at 284 178 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "645789fe-7977-4382-a3e7-9202a9d1d7df")
	)
	(text "[3] 信号"
		(exclude_from_sim no)
		(at 284 185 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a2fa1dfe-ac33-4c61-8dbc-8b5ae4067a39")
	)
	(text "  R_THP+C_THP: 125kHz TH_PWM の dv/dt を落とし、隣接する ENV_ADC へのクロストークを抑える"
		(exclude_from_sim no)
		(at 284 190 0)
		(effects
