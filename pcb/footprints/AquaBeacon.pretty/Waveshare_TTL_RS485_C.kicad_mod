(footprint "Waveshare_TTL_RS485_C"
	(version 20240108)
	(generator "aquabeacon")
	(generator_version "8.0")
	(layer "F.Cu")
	(descr "Waveshare TTL TO RS485 (C) galvanic-isolated module (SwitchScience 9778 / WS 27479). Castellated half-holes, soldered onto carrier board. Body 42.8x15.2x4.75mm. Pads on the two SHORT (15.2mm) edges. TTL edge = 4 pads @2.54mm: 1=GND 2=RXD 3=TXD 4=VCC(3.3-5V). RS485 edge = 3 pads @5.08mm: 5=PE(iso-signal-GND) 6=B- 7=A+. Automatic direction control (no DE/RE), half-duplex, isolated -> RS485 pair floats (no ground wire needed on tether). 120R termination = solder jumper on module (default). Verified vs Waveshare wiki mechanical drawing 2025-07; pad half-hole diameter/edge-offset not dimensioned -> confirm with calipers on real part.")
	(tags "waveshare rs485 castellated isolated 7pad")
