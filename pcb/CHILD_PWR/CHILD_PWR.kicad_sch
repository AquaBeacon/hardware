		(uuid "c2cb3828-2298-4f17-82e3-af9ae945e3a0")
	)
	(text "  J_BAT -> F1(3A 速断) -> Q1(2SJ349 逆接保護) -> SW_PWR"
		(exclude_from_sim no)
		(at 256 141 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba8c5523-31d2-463b-985f-6453a6ab8285")
	)
	(text "  -> R_SH(20m, INA226 Kelvin 検出) -> VBAT_M -> 各負荷"
		(exclude_from_sim no)
		(at 256 146 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2443a187-6f9e-4490-a5dc-f81ef2240b88")
	)
	(text "  F1 は速断(F)必須: 遅動だと逆接時に TVS(D1) が先に破壊する (LTspice 実証)"
		(exclude_from_sim no)
		(at 256 151 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a9be6b4f-1241-4b07-8515-af6586ebbbab")
	)
	(text "  C_BLK 470u -> 100u で投入突入を 42A -> 31.4A へ低減 (SW_PWR 3A 接点の保護)"
		(exclude_from_sim no)
		(at 256 156 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "71eb6a1e-af6f-419f-979e-9b39baf82eee")
	)
	(text "[2] 電源レール"
		(exclude_from_sim no)
		(at 256 166 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "e1705cc8-357a-408e-893c-d403ee800699")
	)
	(text "  PS1 = AE-LXDC55-5V (SIP3: I/G/O)。11x25 モジュール縦挿し = 実高 35.1mm"
		(exclude_from_sim no)
		(at 256 171 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0fe58b8c-19a8-4ead-b9a3-ec7a955e4daf")
	)
	(text "  REG3D/REG3A = NJU7223F33 (TO-220F, 1=VOUT 2=VIN 3=GND / Io max 500mA)"
		(exclude_from_sim no)
		(at 256 176 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "03ecd6f9-8972-4add-bc26-ac903f962d1f")
	)
	(text "  V3A は本基板に負荷なし。J_MAIN(3) -> C-MAIN -> J_RX1 -> RX 基板 のパススルー"
		(exclude_from_sim no)
		(at 256 181 0)
		(effects
